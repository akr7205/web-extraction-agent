# Web Extraction Agent Configuration

# Enable LLM-based extraction
USE_LLM=true

# ============= LITELLM CONFIGURATION =============
# LiteLLM API key
LITELLM_API_KEY=replace-with-litellm-key

# LiteLLM Base URL
LITELLM_BASE_URL=https://litellm-api.predev.praveg.ai/v1

# LiteLLM Model to use
LITELLM_MODEL=deepinfra/Qwen/Qwen3-235B-A22B-Thinking-2507

# LiteLLM Temperature (0.0-1.0)
LITELLM_TEMPERATURE=0.7

# Use LiteLLM async jobs (true/false)
LITELLM_USE_JOB=true

# Debug mode (verbose logging)
DEBUG=false
